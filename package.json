{
  "name": "boosterev",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node dev.js",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "lint": "npm --workspace client run lint || true",
    "ship": "git add . && git commit -m \"update\" && git push"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@paper-design/shaders": "^0.0.80",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.3",
    "lucide-react": "^1.45.0",
    "node-fetch": "^3.3.2",
    "ogl": "^1.0.11",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
